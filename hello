SELECT TRIM(MATKL) AS MATKL, COUNT(*) AS nb
FROM BASE_ARTICLE
WHERE UPPER(TRIM(MATKL)) IN ('XXX','YYY','000','0','NA','N/A','ZZZ')
GROUP BY TRIM(MATKL)
ORDER BY nb DESC;





SELECT TRIM(MATKL) AS MATKL,
       COUNT(*) AS nb,
       COUNT(DISTINCT MAKTX) AS nb_designations_distinctes
FROM BASE_ARTICLE
WHERE MATKL IS NOT NULL AND TRIM(MATKL) <> ''
GROUP BY TRIM(MATKL)
ORDER BY nb DESC;




SELECT TRIM(MTART) AS MTART,
       COUNT(*) AS nb_total,
       SUM(CASE WHEN MATKL IS NULL OR TRIM(MATKL) = '' THEN 1 ELSE 0 END) AS gm_vide,
       SUM(CASE WHEN UPPER(TRIM(MATKL)) IN ('XXX','YYY','000','0','NA','N/A','ZZZ')
                THEN 1 ELSE 0 END) AS gm_placeholder
FROM BASE_ARTICLE
GROUP BY TRIM(MTART)
ORDER BY nb_total DESC;




-- 6a : longueur (pour détecter la structure hiérarchique)
SELECT LEN(TRIM(PRDHA)) AS longueur, COUNT(*) AS nb
FROM BASE_ARTICLE
WHERE PRDHA IS NOT NULL AND TRIM(PRDHA) <> ''
GROUP BY LEN(TRIM(PRDHA))
ORDER BY longueur;

-- 6b : top 30 valeurs
SELECT TOP 30 TRIM(PRDHA) AS PRDHA, COUNT(*) AS nb
FROM BASE_ARTICLE
WHERE PRDHA IS NOT NULL AND TRIM(PRDHA) <> ''
GROUP BY TRIM(PRDHA)
ORDER BY nb DESC;




-- 7a : top 20 fabricants + dispersion des GM
SELECT TOP 20 TRIM(MFRNR) AS MFRNR,
       COUNT(*) AS nb,
       COUNT(DISTINCT MATKL) AS nb_gm_distinct
FROM BASE_ARTICLE
WHERE MFRNR IS NOT NULL AND TRIM(MFRNR) <> ''
GROUP BY TRIM(MFRNR)
ORDER BY nb DESC;

-- 7b : histogramme nb d'articles par fabricant
SELECT nb_articles, COUNT(*) AS nb_fabricants
FROM (
    SELECT TRIM(MFRNR) AS f, COUNT(*) AS nb_articles
    FROM BASE_ARTICLE
    WHERE MFRNR IS NOT NULL AND TRIM(MFRNR) <> ''
    GROUP BY TRIM(MFRNR)
) t
GROUP BY nb_articles
ORDER BY nb_articles;




WITH q AS (
    SELECT CASE
        WHEN MAKTX IS NULL OR TRIM(MAKTX) = '' THEN '00 - vide'
        WHEN LEN(TRIM(MAKTX)) <= 3  THEN '01 - 1-3 car.'
        WHEN LEN(TRIM(MAKTX)) <= 10 THEN '02 - 4-10 car.'
        WHEN LEN(TRIM(MAKTX)) <= 20 THEN '03 - 11-20 car.'
        WHEN LEN(TRIM(MAKTX)) <= 30 THEN '04 - 21-30 car.'
        ELSE '05 - > 30 car.'
    END AS tranche_longueur
    FROM BASE_ARTICLE
)
SELECT tranche_longueur, COUNT(*) AS nb
FROM q
GROUP BY tranche_longueur
ORDER BY tranche_longueur;




WITH q AS (
    SELECT CASE
        WHEN MAKTX IS NULL OR TRIM(MAKTX) = ''            THEN 'A - vide / NULL'
        WHEN UPPER(TRIM(MAKTX)) LIKE '%NE PAS UTILISER%'  THEN 'B - ne pas utiliser'
        WHEN UPPER(TRIM(MAKTX)) LIKE '%NE PLUS UTILISER%' THEN 'B - ne pas utiliser'
        WHEN UPPER(TRIM(MAKTX)) LIKE '%OBSOLETE%'         THEN 'C - obsolete / a supprimer'
        WHEN UPPER(TRIM(MAKTX)) LIKE '%A SUPPRIMER%'      THEN 'C - obsolete / a supprimer'
        WHEN UPPER(TRIM(MAKTX)) LIKE '%DOUBLON%'          THEN 'C - obsolete / a supprimer'
        WHEN UPPER(TRIM(MAKTX)) LIKE '%ERREUR%'           THEN 'C - obsolete / a supprimer'
        WHEN UPPER(TRIM(MAKTX)) LIKE '%TEST%'             THEN 'D - test'
        WHEN UPPER(TRIM(MAKTX)) IN ('XXX','XXXXX','YYY','ZZZ','NA','N/A','SANS','DIVERS','AUTRE','AUTRES')
                                                          THEN 'E - placeholder'
        WHEN TRIM(MAKTX) NOT LIKE '%[^0-9 ]%'             THEN 'F - uniquement chiffres'
        WHEN LEN(TRIM(MAKTX)) <= 3                        THEN 'G - trop court (<=3)'
        ELSE 'Z - exploitable a priori'
    END AS categorie_qualite
    FROM BASE_ARTICLE
)
SELECT categorie_qualite, COUNT(*) AS nb
FROM q
GROUP BY categorie_qualite
ORDER BY categorie_qualite;




