SELECT TOP 30 nb_occurrences, COUNT(*) AS nb_designations_distinctes
FROM (
    SELECT LOWER(TRIM(MAKTX)) AS d, COUNT(*) AS nb_occurrences
    FROM BASE_ARTICLE
    WHERE MAKTX IS NOT NULL AND TRIM(MAKTX) <> ''
    GROUP BY LOWER(TRIM(MAKTX))
) t
GROUP BY nb_occurrences
ORDER BY nb_occurrences;





WITH gm AS (
    SELECT TRIM(MATKL) AS g, COUNT(*) AS nb
    FROM BASE_ARTICLE
    WHERE MATKL IS NOT NULL AND TRIM(MATKL) <> ''
    GROUP BY TRIM(MATKL)
), t AS (
    SELECT CASE
             WHEN nb = 1     THEN '1 article'
             WHEN nb <= 5    THEN '2-5'
             WHEN nb <= 20   THEN '6-20'
             WHEN nb <= 100  THEN '21-100'
             WHEN nb <= 1000 THEN '101-1000'
             ELSE '> 1000'
           END AS taille_gm,
           nb
    FROM gm
)
SELECT taille_gm, COUNT(*) AS nb_gm, SUM(nb) AS nb_articles_couverts
FROM t
GROUP BY taille_gm
ORDER BY taille_gm;






SELECT SUBSTRING(TRIM(MATKL), 1, 1) AS niveau_1,
       COUNT(*) AS nb,
       COUNT(DISTINCT MATKL) AS nb_gm_dans_niveau
FROM BASE_ARTICLE
WHERE MATKL IS NOT NULL AND TRIM(MATKL) <> ''
GROUP BY SUBSTRING(TRIM(MATKL), 1, 1)
ORDER BY nb DESC;








-- 13a : distribution
SELECT nb_gm, COUNT(*) AS nb_designations
FROM (
    SELECT LOWER(TRIM(MAKTX)) AS d, COUNT(DISTINCT TRIM(MATKL)) AS nb_gm
    FROM BASE_ARTICLE
    WHERE MAKTX IS NOT NULL AND TRIM(MAKTX) <> ''
      AND MATKL IS NOT NULL AND TRIM(MATKL) <> ''
      AND UPPER(TRIM(MATKL)) NOT IN ('XXX','YYY','000','0','NA','N/A','ZZZ')
    GROUP BY LOWER(TRIM(MAKTX))
) t
GROUP BY nb_gm
ORDER BY nb_gm;

-- 13b : exemples concrets pour le PPT
WITH conflits AS (
    SELECT LOWER(TRIM(MAKTX)) AS d
    FROM BASE_ARTICLE
    WHERE MAKTX IS NOT NULL AND TRIM(MAKTX) <> ''
      AND MATKL IS NOT NULL AND TRIM(MATKL) <> ''
      AND UPPER(TRIM(MATKL)) NOT IN ('XXX','YYY','000','0','NA','N/A','ZZZ')
    GROUP BY LOWER(TRIM(MAKTX))
    HAVING COUNT(DISTINCT TRIM(MATKL)) >= 3
)
SELECT TOP 100
       LOWER(TRIM(a.MAKTX)) AS designation,
       TRIM(a.MATKL) AS MATKL,
       COUNT(*) AS nb
FROM BASE_ARTICLE a
INNER JOIN conflits c ON LOWER(TRIM(a.MAKTX)) = c.d
GROUP BY LOWER(TRIM(a.MAKTX)), TRIM(a.MATKL)
ORDER BY designation, nb DESC;




WITH f AS (
    SELECT TRIM(MFRNR) AS fab,
           COUNT(DISTINCT TRIM(MATKL)) AS nb_gm,
           COUNT(*) AS nb_articles
    FROM BASE_ARTICLE
    WHERE MFRNR IS NOT NULL AND TRIM(MFRNR) <> ''
      AND MATKL IS NOT NULL AND TRIM(MATKL) <> ''
      AND UPPER(TRIM(MATKL)) NOT IN ('XXX','YYY','000','0','NA','N/A','ZZZ')
    GROUP BY TRIM(MFRNR)
)
SELECT CASE WHEN nb_gm = 1 THEN '1 seul GM'
            WHEN nb_gm <= 3 THEN '2-3 GM'
            WHEN nb_gm <= 10 THEN '4-10 GM'
            ELSE '> 10 GM' END AS dispersion,
       COUNT(*) AS nb_fabricants,
       SUM(nb_articles) AS nb_articles
FROM f
GROUP BY CASE WHEN nb_gm = 1 THEN '1 seul GM'
              WHEN nb_gm <= 3 THEN '2-3 GM'
              WHEN nb_gm <= 10 THEN '4-10 GM'
              ELSE '> 10 GM' END;





