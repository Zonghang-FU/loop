# -*- coding: utf-8 -*-
"""
GROUPE DE MARCHANDISE - PREDICTION NIVEAU 1 (10 classes A-J)
Backtest automatique de la cascade :
    L0  libelle exact       (dictionnaire, vote majoritaire)
    L1  premier mot         (dictionnaire)
    L2  deux premiers mots  (dictionnaire)
    L3  modele ML           (TF-IDF word+char + MTART)

Recipe Dataiku Python.
  INPUT   : BASE_ARTICLE
  OUTPUTS : EVAL_SUMMARY, EVAL_PER_CLASS, EVAL_COVERAGE_CURVE
Duree indicative : 15-30 min sur 1.2M lignes.
"""
import re, sys, time, unicodedata
import numpy as np
import pandas as pd

from sklearn.model_selection import GroupShuffleSplit
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.preprocessing import OneHotEncoder
from sklearn.svm import LinearSVC
from sklearn.linear_model import SGDClassifier
from sklearn.metrics import accuracy_score, f1_score, classification_report
from scipy.sparse import hstack

# ----------------------------------------------------------------- CONFIG
RANDOM_STATE  = 42
TEST_SIZE     = 0.20
MAX_CHAR_FEAT = 300000     # baisser a 150000 si MemoryError
RUN_LINSVC    = True       # False -> uniquement SGD (beaucoup plus rapide)
IN_DATASET    = "BASE_ARTICLE"

PLACEHOLDER = {'000','XXX','YYY','ZZZ','0','NA','N/A','0M5','Z00000',''}
GARBAGE     = {'','test','testspn','test spn','na','n a','xxx','xxxxx','yyy','zzz',
               'sans','divers','autre','autres','neant','reserve','a definir',
               'article non defini','sans designation'}

RE_FILL  = re.compile(r'[.\-_*=~/#+]{2,}')
RE_PUNCT = re.compile(r'[^a-z0-9 ]')
RE_SP    = re.compile(r'\s+')

def log(msg):
    print("[%s] %s" % (time.strftime("%H:%M:%S"), msg)); sys.stdout.flush()

# ------------------------------------------------------- NORMALISATION
def norm_text(s):
    if s is None:
        return ''
    if isinstance(s, float) and np.isnan(s):
        return ''
    s = str(s).lower()
    s = unicodedata.normalize('NFKD', s)
    s = ''.join(c for c in s if not unicodedata.combining(c))   # accents
    s = RE_FILL.sub(' ', s)          # ...... ------ ****** -> espace
    s = RE_PUNCT.sub(' ', s)
    return RE_SP.sub(' ', s).strip()

def clean_niv1(m):
    if m is None:
        return None
    m = str(m).strip().upper()
    if m in PLACEHOLDER:
        return None
    return m[:1]

# ------------------------------------------------------------- CHARGEMENT
log("chargement...")
try:
    import dataiku
    df = dataiku.Dataset(IN_DATASET).get_dataframe(
            columns=['MATNR', 'MTART', 'MATKL', 'MAKTX'])
except Exception:
    # execution hors Dataiku : CSV local
    df = pd.read_csv(sys.argv[1], usecols=['MATNR','MTART','MATKL','MAKTX'],
                     dtype=str, sep=';')
log("%d lignes chargees" % len(df))

df['lib']   = df['MAKTX'].map(norm_text)
df['niv1']  = df['MATKL'].map(clean_niv1)
df['MTART'] = df['MTART'].fillna('NA').astype(str).str.strip()

desc_ok = ((~df['lib'].isin(GARBAGE)) &
           (df['lib'].str.len() > 3) &
           (~df['lib'].str.replace(' ', '', regex=False).str.isdigit()))
df['desc_ok'] = desc_ok

lab   = df[df.desc_ok & df.niv1.notna()].copy()
cible = df[df.desc_ok & df.niv1.isna() & (df.MTART != 'PROD')].copy()
log("pool etiquete   : %d" % len(lab))
log("a completer     : %d" % len(cible))

def mot1(s): return s.split(' ')[0] if s else ''
def mot2(s):
    p = s.split(' '); return ' '.join(p[:2]) if p else ''
for d in (lab, cible):
    d['mot1'] = d['lib'].map(mot1)
    d['mot2'] = d['lib'].map(mot2)

# --------------------------------------------------- DICTIONNAIRE (vote maj.)
def build_dico(d, key):
    """key -> classe majoritaire, effectif, purete"""
    g = d.groupby([key, 'niv1']).size().rename('n').reset_index()
    tot = g.groupby(key)['n'].sum().rename('n_tot')
    g = g.merge(tot, left_on=key, right_index=True)
    g = g.sort_values([key, 'n'], ascending=[True, False]).drop_duplicates(key)
    g['purete'] = g['n'] / g['n_tot']
    return g.set_index(key)[['niv1', 'n_tot', 'purete']] \
            .rename(columns={'niv1': 'pred'})

def eval_dico(dico, test, key, min_n=1, min_pur=0.0):
    j = test.join(dico, on=key)
    hit = j['pred'].notna() & (j['n_tot'] >= min_n) & (j['purete'] >= min_pur)
    if hit.sum() == 0:
        return 0.0, np.nan, hit
    acc = (j.loc[hit, 'pred'] == j.loc[hit, 'niv1']).mean()
    return hit.mean(), acc, hit

# ============================================================== SPLITS
# Split R : aleatoire par ligne  -> mesure la cascade en conditions "melangees"
rng  = np.random.RandomState(RANDOM_STATE)
mR   = rng.rand(len(lab)) < TEST_SIZE
trR, teR = lab[~mR].copy(), lab[mR].copy()

# Split G : groupe par libelle   -> TOUS les libelles de test sont INEDITS
#           => mesure honnete du regime "nouveau libelle" (63% de la cible)
gss = GroupShuffleSplit(n_splits=1, test_size=TEST_SIZE, random_state=RANDOM_STATE)
iG, jG = next(gss.split(lab, groups=lab['lib']))
trG, teG = lab.iloc[iG].copy(), lab.iloc[jG].copy()
log("split R : train %d / test %d" % (len(trR), len(teR)))
log("split G : train %d / test %d  (libelles disjoints)" % (len(trG), len(teG)))

rows = []
def add(couche, protocole, perimetre, couverture, precision, n_test):
    rows.append(dict(couche=couche, protocole=protocole, perimetre=perimetre,
                     couverture=round(float(couverture), 4),
                     precision=round(float(precision), 4) if precision == precision else None,
                     n_test=int(n_test)))

# ---------------------------------------------------------- BASELINE
maj_cls = trR['niv1'].value_counts().idxmax()
add('BASELINE classe majoritaire (%s)' % maj_cls, 'split R', 'tout',
    1.0, (teR['niv1'] == maj_cls).mean(), len(teR))

# ---------------------------------------------------------- L0 libelle exact
log("L0 : dictionnaire libelle exact")
d0 = build_dico(trR, 'lib')
for pur in (0.0, 0.90, 0.99):
    cov, acc, _ = eval_dico(d0, teR, 'lib', min_pur=pur)
    add('L0 libelle exact (purete>=%.2f)' % pur, 'split R', 'tout', cov, acc, len(teR))

# ------------------------------------------------- L1/L2 sur libelles INEDITS
log("L1/L2 : retombee sur mot1 / mot2, evaluee sur libelles inedits")
d1 = build_dico(trG, 'mot1')
d2 = build_dico(trG, 'mot2')
for name, dico, key in (('L1 premier mot', d1, 'mot1'),
                        ('L2 deux premiers mots', d2, 'mot2')):
    for mn, mp in ((1, 0.0), (10, 0.0), (10, 0.70), (10, 0.90)):
        cov, acc, _ = eval_dico(dico, teG, key, min_n=mn, min_pur=mp)
        add('%s (n>=%d, purete>=%.2f)' % (name, mn, mp),
            'split G', 'libelles inedits', cov, acc, len(teG))

# ================================================================ L3 : ML
log("L3 : vectorisation")
def fit_feats(d):
    vw = TfidfVectorizer(analyzer='word', ngram_range=(1, 2),
                         min_df=2, sublinear_tf=True)
    vc = TfidfVectorizer(analyzer='char_wb', ngram_range=(3, 5), min_df=3,
                         sublinear_tf=True, max_features=MAX_CHAR_FEAT)
    ve = OneHotEncoder(handle_unknown='ignore')
    Xw = vw.fit_transform(d['lib']); Xc = vc.fit_transform(d['lib'])
    Xm = ve.fit_transform(d[['MTART']])
    return (vw, vc, ve), hstack([Xw, Xc, Xm * 0.5]).tocsr()

def apply_feats(enc, d):
    vw, vc, ve = enc
    return hstack([vw.transform(d['lib']), vc.transform(d['lib']),
                   ve.transform(d[['MTART']]) * 0.5]).tocsr()

enc, Xtr = fit_feats(trG)
Xte      = apply_feats(enc, teG)
ytr, yte = trG['niv1'].values, teG['niv1'].values
log("features : %s" % (Xtr.shape,))

models = [('L3 SGD modified_huber',
           SGDClassifier(loss='modified_huber', alpha=1e-6, max_iter=25,
                         tol=1e-4, class_weight='balanced',
                         random_state=RANDOM_STATE, n_jobs=-1))]
if RUN_LINSVC:
    models.append(('L3 LinearSVC',
                   LinearSVC(C=0.5, class_weight='balanced', max_iter=3000)))

best = None
per_class_rows, curve_rows = [], []
for name, clf in models:
    log("entrainement %s ..." % name)
    t0 = time.time()
    clf.fit(Xtr, ytr)
    S    = clf.decision_function(Xte)
    pred = clf.classes_[S.argmax(1)]
    Ss   = np.sort(S, axis=1)
    conf = Ss[:, -1] - Ss[:, -2]          # marge top1 - top2
    acc  = accuracy_score(yte, pred)
    mf1  = f1_score(yte, pred, average='macro')
    log("  %s  acc=%.4f  macroF1=%.4f  (%.0fs)" % (name, acc, mf1, time.time() - t0))
    add(name, 'split G', 'libelles inedits', 1.0, acc, len(teG))
    rows[-1]['macro_f1'] = round(float(mf1), 4)

    if best is None or acc > best[1]:
        best = (name, acc, pred, conf, clf)

name, acc, pred, conf, clf = best
log("meilleur modele : %s" % name)

# --- courbe couverture / precision (mecanisme d'abstention)
for q in [0.0, 0.10, 0.20, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80, 0.90]:
    thr = np.quantile(conf, q)
    m   = conf >= thr
    curve_rows.append(dict(seuil_quantile=q, seuil_marge=round(float(thr), 4),
                           couverture=round(float(m.mean()), 4),
                           precision=round(float(accuracy_score(yte[m], pred[m])), 4)))

# --- detail par classe et par MTART
rep = classification_report(yte, pred, output_dict=True, zero_division=0)
for k, v in rep.items():
    if isinstance(v, dict) and len(k) == 1:
        per_class_rows.append(dict(niveau_1=k, precision=round(v['precision'], 4),
                                   recall=round(v['recall'], 4),
                                   f1=round(v['f1-score'], 4), support=int(v['support'])))
teG = teG.assign(_pred=pred)
for t, g in teG.groupby('MTART'):
    if len(g) >= 500:
        add('%s | MTART=%s' % (name, t), 'split G', 'libelles inedits',
            1.0, (g['_pred'] == g['niv1']).mean(), len(g))

# ================================================ PERFORMANCE ATTENDUE REELLE
log("projection sur la cible reelle")
d0_full = build_dico(lab, 'lib')
d1_full = build_dico(lab, 'mot1')
cj  = cible.join(d0_full, on='lib')
p_l0 = cj['pred'].notna().mean()
rest = cj[cj['pred'].isna()].join(d1_full.rename(columns={'pred':'pred1',
          'n_tot':'n_tot1','purete':'purete1'}), on='mot1')
p_l1 = ((rest['pred1'].notna()) & (rest['n_tot1'] >= 10) &
        (rest['purete1'] >= 0.70)).mean() * (1 - p_l0)

acc_l0 = [r for r in rows if r['couche'].startswith('L0 libelle exact (purete>=0.00')][0]['precision']
acc_l1 = [r for r in rows if r['couche'].startswith('L1 premier mot (n>=10, purete>=0.70')][0]['precision']
p_l3   = 1 - p_l0 - p_l1
attendu = p_l0 * acc_l0 + p_l1 * (acc_l1 or 0) + p_l3 * acc

rows.append(dict(couche='>>> PERFORMANCE ATTENDUE SUR LES %d ARTICLES A COMPLETER' % len(cible),
                 protocole='projection', perimetre='L0 %.1f%% + L1 %.1f%% + ML %.1f%%'
                 % (p_l0*100, p_l1*100, p_l3*100),
                 couverture=1.0, precision=round(float(attendu), 4), n_test=len(cible)))

summary = pd.DataFrame(rows)
curve   = pd.DataFrame(curve_rows)
percls  = pd.DataFrame(per_class_rows).sort_values('support', ascending=False)

print("\n" + "=" * 100)
print(summary.to_string(index=False))
print("\n--- COUVERTURE / PRECISION (abstention sur la marge) ---")
print(curve.to_string(index=False))
print("\n--- DETAIL PAR CLASSE NIVEAU 1 (libelles inedits) ---")
print(percls.to_string(index=False))
print("=" * 100)

try:
    import dataiku
    dataiku.Dataset("EVAL_SUMMARY").write_with_schema(summary)
    dataiku.Dataset("EVAL_COVERAGE_CURVE").write_with_schema(curve)
    dataiku.Dataset("EVAL_PER_CLASS").write_with_schema(percls)
except Exception as e:
    log("ecriture Dataiku ignoree (%s)" % e)
    summary.to_csv("EVAL_SUMMARY.csv", index=False, sep=';')
    curve.to_csv("EVAL_COVERAGE_CURVE.csv", index=False, sep=';')
    percls.to_csv("EVAL_PER_CLASS.csv", index=False, sep=';')
log("termine")









