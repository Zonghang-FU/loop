# -*- coding: utf-8 -*-
"""
GM - EVALUATION HIERARCHIQUE v4
===============================
Corrections vs v3 :
  [FIX] L0 avait une couverture de 0 : le split groupe rend le match exact
        IMPOSSIBLE par construction (libelles disjoints). -> double protocole :
          split G (groupe) : regime "libelle inedit"  -> ML  (L0 mort, normal)
          split R (aleatoire) : regime "deja vu"      -> L0  (dicos seulement,
                                                        pas de ML : inutile,
                                                        les lignes L0 n'y vont pas)
        Les deux sont ensuite ponderes par le taux de match L0 mesure sur la
        VRAIE cible.
  [DROP] L1b retire du chemin par defaut : sa contribution nette mesuree est
        -0.60pt (niv1) / +0.57pt (niv2) / -0.06pt (niv3) face au ML sur LES
        MEMES LIGNES. Conserve uniquement pour la table de contribution.
  [NEW] evaluation par niveau demandee :
          - denominateur = uniquement les articles ayant une verite a ce niveau
          - 'granularite native' : chaque article juge a SA propre finesse
          - 3 modes : direct / vote / any_match (oracle)
  [NEW] predictions produites sur TOUTES les lignes de test (les 3 modeles),
        pas seulement celles ayant une verite au niveau concerne.

INPUT   : BASE_ARTICLE
OUTPUTS : EVAL_NIVEAUX, EVAL_NATIVE, EVAL_CONTRIB_L1B, EVAL_L0, EVAL_PROJECTION
"""
import re, sys, time, unicodedata, threading
import numpy as np
import pandas as pd

from joblib import Parallel, delayed
from sklearn.model_selection import GroupShuffleSplit
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.preprocessing import OneHotEncoder
from sklearn.svm import LinearSVC
from sklearn.linear_model import SGDClassifier
from sklearn.metrics import accuracy_score, f1_score

RANDOM_STATE, TEST_SIZE = 42, 0.20
MAX_CHAR_FEAT = 200000
IN_DATASET    = "BASE_ARTICLE"
LEVELS        = ['niv1', 'niv2', 'niv3']
PARALLEL      = True
MTART_FOCUS   = ['DEFI', 'HERS', 'CATA', 'PROS']
MODEL_BY_LEVEL = {'niv1': 'linsvc', 'niv2': 'sgd', 'niv3': 'sgd'}
PUR_L0, PUR_L1B, MIN_N_L1B = 0.90, 0.70, 10

PLACEHOLDER = {'000','XXX','YYY','ZZZ','0','NA','N/A','0M5','Z00000','',
               'NAN','NONE','NULL'}
GARBAGE = {'','test','testspn','test spn','na','n a','xxx','xxxxx','yyy','zzz',
           'sans','divers','autre','autres','neant','reserve','a definir',
           'article non defini','sans designation'}
RE_FILL, RE_PUNCT, RE_SP = (re.compile(r'[.\-_*=~/#+]{2,}'),
                            re.compile(r'[^a-z0-9 ]'), re.compile(r'\s+'))
_lock = threading.Lock()
def log(m):
    with _lock:
        print("[%s] %s" % (time.strftime("%H:%M:%S"), m)); sys.stdout.flush()

def norm_text(s):
    if s is None or (isinstance(s, float) and np.isnan(s)): return ''
    s = unicodedata.normalize('NFKD', str(s).lower())
    s = ''.join(c for c in s if not unicodedata.combining(c))
    return RE_SP.sub(' ', RE_PUNCT.sub(' ', RE_FILL.sub(' ', s))).strip()

def split_levels(m):
    if m is None or (isinstance(m, float) and np.isnan(m)): return (None, None, None)
    m = str(m).strip().upper()
    if m in PLACEHOLDER: return (None, None, None)
    return (m[:1], m[:3] if len(m) >= 3 else None, m if len(m) == 5 else None)

# ---------------------------------------------------------------- CHARGEMENT
log("chargement...")
try:
    import dataiku
    df = dataiku.Dataset(IN_DATASET).get_dataframe(columns=['MATNR','MTART','MATKL','MAKTX'])
except Exception:
    df = pd.read_csv(sys.argv[1], usecols=['MATNR','MTART','MATKL','MAKTX'], dtype=str, sep=';')

df['lib']   = df['MAKTX'].map(norm_text)
df['MTART'] = df['MTART'].fillna('NA').astype(str).str.strip()
lv = df['MATKL'].map(split_levels)
df['niv1'] = [x[0] for x in lv]; df['niv2'] = [x[1] for x in lv]; df['niv3'] = [x[2] for x in lv]
assert 'N' not in set(df['niv1'].dropna()), "bug NaN non corrige"
df['desc_ok'] = ((~df['lib'].isin(GARBAGE)) & (df['lib'].str.len() > 3) &
                 (~df['lib'].str.replace(' ', '', regex=False).str.isdigit()))
lab   = df[df.desc_ok & df.niv1.notna()].copy()
cible = df[df.desc_ok & df.niv1.isna()].copy()
for d in (lab, cible):
    d['mot1'] = d['lib'].map(lambda s: s.split(' ')[0] if s else '')
# granularite native de chaque article etiquete
lab['granularite'] = np.where(lab.niv3.notna(), 'niv3',
                       np.where(lab.niv2.notna(), 'niv2', 'niv1'))
log("etiquetes %d | cible %d" % (len(lab), len(cible)))
log("granularite native : %s" % lab.granularite.value_counts().to_dict())

# ------------------------------------------------------------------ DICOS
def build_dico(d, keys, level):
    keys = keys if isinstance(keys, list) else [keys]
    d = d[d[level].notna()]
    g   = d.groupby(keys + [level]).size().rename('n').reset_index()
    tot = g.groupby(keys)['n'].sum().rename('n_tot').reset_index()
    g   = g.merge(tot, on=keys).sort_values(keys + ['n'],
              ascending=[True]*len(keys) + [False]).drop_duplicates(keys)
    g['purete'] = g['n'] / g['n_tot']
    return g[keys + [level,'n_tot','purete']].rename(columns={level:'pred'}).set_index(keys)

def lookup(dico, d, keys, min_n, min_pur):
    keys = keys if isinstance(keys, list) else [keys]
    j = d.join(dico, on=keys)
    hit = (j['pred'].notna() & (j['n_tot'].fillna(0) >= min_n)
           & (j['purete'].fillna(0) >= min_pur))
    return j['pred'].values, hit.values

# ============================ PROTOCOLE R : mesure de L0 (dicos seuls, pas de ML)
log("protocole R (aleatoire) : mesure du match exact L0")
rng = np.random.RandomState(RANDOM_STATE)
mR = rng.rand(len(lab)) < TEST_SIZE
trR, teR = lab[~mR], lab[mR]
rows_l0 = []
for L in LEVELS:
    d0 = build_dico(trR, 'lib', L)
    for pur in (0.0, PUR_L0):
        p, h = lookup(d0, teR, 'lib', 1, pur)
        for scope in ['*TOUS*'] + MTART_FOCUS:
            sel = np.ones(len(teR), bool) if scope == '*TOUS*' else (teR.MTART == scope).values
            sel &= teR[L].notna().values
            if sel.sum() < 300: continue
            hh = h & sel
            rows_l0.append(dict(niveau=L, mtart=scope, purete_min=pur,
                couverture=round(float(hh.sum()/sel.sum()), 4),
                precision=round(float((p[hh] == teR[L].values[hh]).mean()), 4) if hh.sum() else None,
                n=int(hh.sum())))
L0 = pd.DataFrame(rows_l0)

# ================ PROTOCOLE G : regime "libelle inedit" -> ML sur 3 niveaux
gss = GroupShuffleSplit(n_splits=1, test_size=TEST_SIZE, random_state=RANDOM_STATE)
iG, jG = next(gss.split(lab, groups=lab['lib']))
trG, teG = lab.iloc[iG].copy(), lab.iloc[jG].copy()
log("protocole G : train %d / test %d (libelles disjoints)" % (len(trG), len(teG)))

log("vectorisation partagee")
vw = TfidfVectorizer(analyzer='word', ngram_range=(1,2), min_df=2, sublinear_tf=True)
vc = TfidfVectorizer(analyzer='char_wb', ngram_range=(3,5), min_df=3,
                     sublinear_tf=True, max_features=MAX_CHAR_FEAT)
ve = OneHotEncoder(handle_unknown='ignore')
from scipy.sparse import hstack
Xtr = hstack([vw.fit_transform(trG['lib']), vc.fit_transform(trG['lib']),
              ve.fit_transform(trG[['MTART']])*0.5]).tocsr()
Xte = hstack([vw.transform(teG['lib']), vc.transform(teG['lib']),
              ve.transform(teG[['MTART']])*0.5]).tocsr()
log("X_train %s" % (Xtr.shape,))

def train_level(L, n_jobs):
    mtr = trG[L].notna().values
    clf = (LinearSVC(C=0.5, class_weight='balanced', max_iter=3000)
           if MODEL_BY_LEVEL[L] == 'linsvc' else
           SGDClassifier(loss='modified_huber', alpha=1e-6, max_iter=25, tol=1e-4,
                         class_weight='balanced', random_state=RANDOM_STATE, n_jobs=n_jobs))
    t = time.time(); clf.fit(Xtr[mtr], trG.loc[mtr, L].values)
    S = clf.decision_function(Xte)                 # <- TOUTES les lignes de test
    if S.ndim == 1: S = np.c_[-S, S]
    Ss = np.sort(S, 1)
    log("  %s entraine (%ds, %d classes)" % (L, time.time()-t, len(clf.classes_)))
    return dict(level=L, pred=clf.classes_[S.argmax(1)], conf=Ss[:,-1]-Ss[:,-2],
                clf=clf, secondes=int(time.time()-t))

log("entrainement des 3 niveaux")
ML = {r['level']: r for r in (
        Parallel(n_jobs=3, prefer="threads")(delayed(train_level)(L,1) for L in LEVELS)
        if PARALLEL else [train_level(L,-1) for L in LEVELS])}

# ------------------------------------------------- table unifiee des predictions
E = pd.DataFrame({'MTART': teG.MTART.values, 'granularite': teG.granularite.values})
for i, L in enumerate(LEVELS, 1):
    E['v%d' % i] = teG[L].values
    E['p%d' % i] = ML[L]['pred']
    E['c%d' % i] = ML[L]['conf']

# derivations : un niveau fin contient les niveaux grossiers
E['p1_de_p2'] = pd.Series(E.p2).str[:1]
E['p1_de_p3'] = pd.Series(E.p3).str[:1]
E['p2_de_p3'] = pd.Series(E.p3).str[:3]

def vote3(a, b, c, defaut):
    """majorite simple sur 3 votants, defaut si egalite parfaite"""
    a, b, c = np.asarray(a), np.asarray(b), np.asarray(c)
    out = np.where((a == b) | (a == c), a, np.where(b == c, b, defaut))
    return out
E['p1_vote'] = vote3(E.p1, E.p1_de_p2, E.p1_de_p3, E.p1)
E['p2_vote'] = np.where(E.p2 == E.p2_de_p3, E.p2, E.p2)   # 2 votants -> pas de majorite

# ======================================= EVALUATION PAR NIVEAU (3 modes)
rows_niv = []
DERIV = {'niv1': ['p1', 'p1_de_p2', 'p1_de_p3'],
         'niv2': ['p2', 'p2_de_p3'],
         'niv3': ['p3']}
VOTE  = {'niv1': 'p1_vote', 'niv2': 'p2_vote', 'niv3': 'p3'}
for i, L in enumerate(LEVELS, 1):
    v = E['v%d' % i]
    for scope in ['*TOUS*'] + MTART_FOCUS:
        sel = v.notna() if scope == '*TOUS*' else (v.notna() & (E.MTART == scope))
        if sel.sum() < 300: continue
        s, vt = E[sel], v[sel]
        direct = (s['p%d' % i] == vt).mean()
        vote   = (s[VOTE[L]] == vt).mean()
        anym   = np.zeros(len(s), bool)
        for col in DERIV[L]:
            anym |= (s[col] == vt).values
        rows_niv.append(dict(niveau=L, mtart=scope, n_evalues=int(sel.sum()),
            part_du_test=round(float(sel.sum()/len(E)), 4),
            acc_direct=round(float(direct), 4),
            acc_vote=round(float(vote), 4),
            acc_any_match_ORACLE=round(float(anym.mean()), 4),
            gain_vote=round(float(vote-direct), 4),
            macro_f1=round(float(f1_score(vt, s['p%d' % i], average='macro',
                                          zero_division=0)), 4)))
NIV = pd.DataFrame(rows_niv)

# ============================= EVALUATION "GRANULARITE NATIVE" (metier)
# chaque article est juge a la finesse a laquelle il a reellement ete saisi
rows_nat = []
idx = {'niv1': 1, 'niv2': 2, 'niv3': 3}
for scope in ['*TOUS*'] + MTART_FOCUS:
    sel = np.ones(len(E), bool) if scope == '*TOUS*' else (E.MTART == scope).values
    if sel.sum() < 300: continue
    s = E[sel]
    ok_d = np.zeros(len(s), bool); ok_v = np.zeros(len(s), bool); ok_a = np.zeros(len(s), bool)
    for g, k in idx.items():
        m = (s.granularite == g).values
        if not m.any(): continue
        vt = s['v%d' % k].values[m]
        ok_d[m] = (s['p%d' % k].values[m] == vt)
        ok_v[m] = (s[VOTE[g]].values[m] == vt)
        a = np.zeros(m.sum(), bool)
        for col in DERIV[g]:
            a |= (s[col].values[m] == vt)
        ok_a[m] = a
    rows_nat.append(dict(mtart=scope, n=int(sel.sum()),
        acc_native_direct=round(float(ok_d.mean()), 4),
        acc_native_vote=round(float(ok_v.mean()), 4),
        acc_native_any_ORACLE=round(float(ok_a.mean()), 4),
        part_niv1=round(float((s.granularite=='niv1').mean()),4),
        part_niv2=round(float((s.granularite=='niv2').mean()),4),
        part_niv3=round(float((s.granularite=='niv3').mean()),4)))
NAT = pd.DataFrame(rows_nat)

# ================== CONTRIBUTION NETTE DE L1B (ML sur LES MEMES lignes)
rows_c = []
for i, L in enumerate(LEVELS, 1):
    d1 = build_dico(trG, ['MTART','mot1'], L)
    p1d, h1 = lookup(d1, teG, ['MTART','mot1'], MIN_N_L1B, PUR_L1B)
    m = E['v%d' % i].notna().values
    for scope in ['*TOUS*'] + MTART_FOCUS:
        sel = m if scope == '*TOUS*' else (m & (E.MTART == scope).values)
        hh = h1 & sel
        if hh.sum() < 300: continue
        vt = E['v%d' % i].values[hh]
        a_dico = float((p1d[hh] == vt).mean())
        a_ml   = float((E['p%d' % i].values[hh] == vt).mean())
        rows_c.append(dict(niveau=L, mtart=scope, couverture_L1b=round(float(hh.sum()/sel.sum()),4),
                           precision_L1b=round(a_dico,4), precision_ML_memes_lignes=round(a_ml,4),
                           contribution_nette=round(a_dico-a_ml,4), n=int(hh.sum())))
CONTRIB = pd.DataFrame(rows_c)

# ===================================== PROJECTION SUR LA CIBLE REELLE
log("projection")
mix = cible.MTART.value_counts(normalize=True)
rows_p = []
for L in LEVELS:
    d0c = build_dico(lab, 'lib', L)
    _, h0c = lookup(d0c, cible, 'lib', 1, PUR_L0)
    tot_w, tot_a = 0.0, 0.0
    for mt, w in mix.items():
        if (cible.MTART == mt).sum() < 200: continue
        cov0 = float(h0c[(cible.MTART == mt).values].mean())
        r_l0 = L0[(L0.niveau==L)&(L0.mtart==mt)&(L0.purete_min==PUR_L0)]
        r_ml = NIV[(NIV.niveau==L)&(NIV.mtart==mt)]
        a0 = float(r_l0.precision.iloc[0]) if len(r_l0) and r_l0.precision.iloc[0] else \
             float(L0[(L0.niveau==L)&(L0.mtart=='*TOUS*')&(L0.purete_min==PUR_L0)].precision.iloc[0])
        a3 = float(r_ml.acc_vote.iloc[0]) if len(r_ml) else \
             float(NIV[(NIV.niveau==L)&(NIV.mtart=='*TOUS*')].acc_vote.iloc[0])
        acc = cov0*a0 + (1-cov0)*a3
        rows_p.append(dict(niveau=L, mtart=mt, n_cible=int((cible.MTART==mt).sum()),
                           poids=round(float(w),4), couverture_L0=round(cov0,4),
                           precision_L0=round(a0,4), precision_ML=round(a3,4),
                           acc_attendue=round(acc,4)))
        tot_w += w; tot_a += w*acc
    rows_p.append(dict(niveau=L, mtart='>>> GLOBAL PONDERE', n_cible=len(cible),
                       poids=1.0, couverture_L0=None, precision_L0=None,
                       precision_ML=None, acc_attendue=round(tot_a/tot_w, 4)))
PROJ = pd.DataFrame(rows_p)

for t, d in [("EVAL_NIVEAUX", NIV), ("EVAL_NATIVE", NAT), ("EVAL_CONTRIB_L1B", CONTRIB),
             ("EVAL_L0", L0), ("EVAL_PROJECTION", PROJ)]:
    print("\n--- %s ---" % t); print(d.to_string(index=False))
    try:
        import dataiku; dataiku.Dataset(t).write_with_schema(d)
    except Exception:
        d.to_csv(t + ".csv", index=False, sep=';')
log("termine")
