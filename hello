SELECT CASE
    WHEN MAKTX IS NULL OR TRIM(MAKTX) = ''                        THEN 'A - vide / NULL'
    WHEN UPPER(TRIM(MAKTX)) LIKE '%NE PAS UTILISER%'              THEN 'B - "ne pas utiliser"'
    WHEN UPPER(TRIM(MAKTX)) LIKE '%NE PLUS UTILISER%'             THEN 'B - "ne pas utiliser"'
    WHEN UPPER(TRIM(MAKTX)) LIKE '%OBSOLETE%'                     THEN 'C - obsolete'
    WHEN UPPER(TRIM(MAKTX)) LIKE '%A SUPPRIMER%'                  THEN 'C - obsolete'
    WHEN UPPER(TRIM(MAKTX)) LIKE '%DOUBLON%'                      THEN 'C - obsolete'
    WHEN UPPER(TRIM(MAKTX)) LIKE '%ERREUR%'                       THEN 'C - obsolete'
    WHEN UPPER(TRIM(MAKTX)) LIKE '%TEST%'                         THEN 'D - test'
    WHEN UPPER(TRIM(MAKTX)) IN ('XXX','XXXXX','YYY','ZZZ','NA','N/A','SANS','DIVERS','AUTRE','AUTRES') THEN 'E - placeholder'
    WHEN TRIM(MAKTX) NOT LIKE '%[^0-9 ]%'                         THEN 'F - uniquement chiffres'
    WHEN LENGTH(TRIM(MAKTX)) <= 3                                 THEN 'G - trop court (<=3)'
    ELSE 'Z - exploitable a priori'
  END AS categorie_qualite,
  COUNT(*) AS nb
FROM BASE_ARTICLE
GROUP BY 1
ORDER BY 1;


