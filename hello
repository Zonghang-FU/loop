WITH n AS (
    SELECT TRIM(MATKL) AS gm, COUNT(*) AS nb
    FROM BASE_ARTICLE
    WHERE MATKL IS NOT NULL AND TRIM(MATKL) <> ''
      AND UPPER(TRIM(MATKL)) NOT IN ('XXX','YYY','000')
    GROUP BY TRIM(MATKL)
)
SELECT LEN(gm) AS longueur_code,
       COUNT(*) AS nb_codes,
       SUM(nb) AS nb_articles
FROM n
GROUP BY LEN(gm)
ORDER BY longueur_code;


SELECT TOP 50 TRIM(MAKTX) AS MAKTX, COUNT(*) AS nb
FROM BASE_ARTICLE
WHERE UPPER(TRIM(MAKTX)) LIKE '%TEST%'
GROUP BY TRIM(MAKTX)
ORDER BY nb DESC;



WITH ref AS (
    SELECT LOWER(TRIM(MAKTX)) AS d,
           COUNT(DISTINCT TRIM(MATKL)) AS nb_gm
    FROM BASE_ARTICLE
    WHERE MAKTX IS NOT NULL AND LEN(TRIM(MAKTX)) > 3
      AND MATKL IS NOT NULL AND TRIM(MATKL) <> ''
      AND UPPER(TRIM(MATKL)) NOT IN ('XXX','YYY','000')
    GROUP BY LOWER(TRIM(MAKTX))
),
cible AS (
    SELECT LOWER(TRIM(MAKTX)) AS d
    FROM BASE_ARTICLE
    WHERE (MATKL IS NULL OR TRIM(MATKL) = ''
           OR UPPER(TRIM(MATKL)) IN ('XXX','YYY','000'))
      AND MAKTX IS NOT NULL AND LEN(TRIM(MAKTX)) > 3
)
SELECT CASE WHEN r.d IS NULL   THEN 'C - non couvert (nouveau libelle)'
            WHEN r.nb_gm = 1   THEN 'A - couvert, GM unique'
            ELSE                    'B - couvert, GM ambigu' END AS statut,
       COUNT(*) AS nb
FROM cible c
LEFT JOIN ref r ON c.d = r.d
GROUP BY CASE WHEN r.d IS NULL THEN 'C - non couvert (nouveau libelle)'
              WHEN r.nb_gm = 1 THEN 'A - couvert, GM unique'
              ELSE                  'B - couvert, GM ambigu' END;



WITH p AS (
    SELECT LEFT(TRIM(PRDHA), 5) AS racine,
           COUNT(DISTINCT TRIM(MATKL)) AS nb_gm,
           COUNT(*) AS nb
    FROM BASE_ARTICLE
    WHERE PRDHA IS NOT NULL AND TRIM(PRDHA) <> ''
      AND LEFT(TRIM(PRDHA), 5) NOT IN ('00000','99999')
      AND MATKL IS NOT NULL AND TRIM(MATKL) <> ''
      AND UPPER(TRIM(MATKL)) NOT IN ('XXX','YYY','000')
    GROUP BY LEFT(TRIM(PRDHA), 5)
)
SELECT CASE WHEN nb_gm = 1 THEN '1 seul GM'
            WHEN nb_gm <= 3 THEN '2-3 GM'
            WHEN nb_gm <= 10 THEN '4-10 GM'
            ELSE '> 10 GM' END AS dispersion,
       COUNT(*) AS nb_racines,
       SUM(nb) AS nb_articles
FROM p
GROUP BY CASE WHEN nb_gm = 1 THEN '1 seul GM'
              WHEN nb_gm <= 3 THEN '2-3 GM'
              WHEN nb_gm <= 10 THEN '4-10 GM'
              ELSE '> 10 GM' END;



WITH m AS (
    SELECT TRIM(MTART) AS t,
           COUNT(DISTINCT SUBSTRING(TRIM(MATKL),1,1)) AS nb_niv1,
           COUNT(DISTINCT TRIM(MATKL)) AS nb_gm,
           COUNT(*) AS nb
    FROM BASE_ARTICLE
    WHERE MATKL IS NOT NULL AND TRIM(MATKL) <> ''
      AND UPPER(TRIM(MATKL)) NOT IN ('XXX','YYY','000')
    GROUP BY TRIM(MTART)
)
SELECT * FROM m ORDER BY nb DESC;




SELECT TOP 20 TRIM(MAKTX) AS MAKTX, TRIM(MTART) AS MTART, COUNT(*) AS nb
FROM BASE_ARTICLE
WHERE TRIM(MATKL) = '0M5'
GROUP BY TRIM(MAKTX), TRIM(MTART)
ORDER BY nb DESC;
