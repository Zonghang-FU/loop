WITH base AS (
  SELECT
    LOWER(LTRIM(RTRIM(MAKTX))) COLLATE SQL_Latin1_General_CP1_CI_AI AS lib,
    CASE WHEN MATKL IS NULL OR LTRIM(RTRIM(MATKL)) = ''
              OR UPPER(LTRIM(RTRIM(MATKL))) IN ('000','XXX','YYY','ZZZ','0','NA','0M5','Z00000')
         THEN NULL ELSE LEFT(LTRIM(RTRIM(MATKL)), 1) END AS niv1
  FROM BASE_ARTICLE
  WHERE MAKTX IS NOT NULL AND LEN(LTRIM(RTRIM(MAKTX))) > 3
),
ref AS (SELECT lib, niv1, COUNT(*) AS n FROM base WHERE niv1 IS NOT NULL GROUP BY lib, niv1),
tot AS (SELECT lib, SUM(n) AS n_tot FROM ref GROUP BY lib),
maj AS (
  SELECT r.lib, r.niv1 AS niv1_maj, r.n AS n_maj, t.n_tot,
         ROW_NUMBER() OVER (PARTITION BY r.lib ORDER BY r.n DESC, r.niv1) AS rk
  FROM ref r JOIN tot t ON t.lib = r.lib
),
dico AS (
  SELECT lib, niv1_maj, n_tot, CAST(n_maj AS FLOAT)/n_tot AS purete
  FROM maj WHERE rk = 1
),
cible AS (SELECT lib FROM base WHERE niv1 IS NULL)
SELECT
  CASE WHEN d.lib IS NULL           THEN 'D - libelle inconnu -> ML'
       WHEN d.purete >= 0.99        THEN 'A - connu, purete >= 99%'
       WHEN d.purete >= 0.90        THEN 'B - connu, purete 90-99%'
       ELSE                              'C - connu, purete < 90%'  END AS classe,
  COUNT(*) AS nb_articles_a_completer
FROM cible c LEFT JOIN dico d ON d.lib = c.lib
GROUP BY CASE WHEN d.lib IS NULL           THEN 'D - libelle inconnu -> ML'
              WHEN d.purete >= 0.99        THEN 'A - connu, purete >= 99%'
              WHEN d.purete >= 0.90        THEN 'B - connu, purete 90-99%'
              ELSE                              'C - connu, purete < 90%'  END
ORDER BY 1;




WITH base AS (
  SELECT MATNR,
    LOWER(LTRIM(RTRIM(MAKTX))) COLLATE SQL_Latin1_General_CP1_CI_AI AS lib,
    CASE WHEN MATKL IS NULL OR LTRIM(RTRIM(MATKL)) = ''
              OR UPPER(LTRIM(RTRIM(MATKL))) IN ('000','XXX','YYY','ZZZ','0','NA','0M5','Z00000')
         THEN NULL ELSE LEFT(LTRIM(RTRIM(MATKL)), 1) END AS niv1
  FROM BASE_ARTICLE
  WHERE MAKTX IS NOT NULL AND LEN(LTRIM(RTRIM(MAKTX))) > 3
),
lab AS (SELECT * FROM base WHERE niv1 IS NOT NULL),
cnt AS (SELECT lib, niv1, COUNT(*) AS n FROM lab GROUP BY lib, niv1),
tot AS (SELECT lib, SUM(n) AS n_tot FROM cnt GROUP BY lib),
-- pour chaque ligne : le vote majoritaire des AUTRES lignes du meme libelle
loo AS (
  SELECT l.MATNR, l.lib, l.niv1 AS vrai,
         (SELECT TOP 1 c.niv1 FROM cnt c
           WHERE c.lib = l.lib
           ORDER BY (c.n - CASE WHEN c.niv1 = l.niv1 THEN 1 ELSE 0 END) DESC, c.niv1) AS predit
  FROM lab l JOIN tot t ON t.lib = l.lib
  WHERE t.n_tot >= 2
)
SELECT COUNT(*) AS nb_evalues,
       SUM(CASE WHEN predit = vrai THEN 1 ELSE 0 END) AS nb_corrects,
       CAST(SUM(CASE WHEN predit = vrai THEN 1 ELSE 0 END) AS FLOAT)/COUNT(*) AS accuracy_L0
FROM loo;



