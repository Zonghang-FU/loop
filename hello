SELECT CASE
         WHEN nb_gm = 1 THEN '1 seul GM'
         WHEN nb_gm <= 3 THEN '2-3 GM'
         WHEN nb_gm <= 10 THEN '4-10 GM'
         ELSE '> 10 GM'
       END AS dispersion,
       COUNT(*) AS nb_fabricants,
       SUM(nb_articles) AS nb_articles
FROM (
    SELECT TRIM(MFRNR) AS f,
           COUNT(DISTINCT TRIM(MATKL)) AS nb_gm,
           COUNT(*) AS nb_articles
    FROM BASE_ARTICLE
    WHERE MFRNR IS NOT NULL AND TRIM(MFRNR) <> ''
      AND MATKL IS NOT NULL AND TRIM(MATKL) <> ''
    GROUP BY TRIM(MFRNR)
) t
GROUP BY 1;

