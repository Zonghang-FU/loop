SELECT nb_lignes_par_matnr, COUNT(*) AS nb_matnr
FROM (
    SELECT MATNR, COUNT(*) AS nb_lignes_par_matnr
    FROM BASE_ARTICLE
    GROUP BY MATNR
) t
GROUP BY nb_lignes_par_matnr
ORDER BY nb_lignes_par_matnr;

