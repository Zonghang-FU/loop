SELECT CASE
         WHEN MAKTX IS NULL OR TRIM(MAKTX) = '' THEN '00 - vide'
         WHEN LENGTH(TRIM(MAKTX)) <= 3  THEN '01 - 1-3 car.'
         WHEN LENGTH(TRIM(MAKTX)) <= 10 THEN '02 - 4-10 car.'
         WHEN LENGTH(TRIM(MAKTX)) <= 20 THEN '03 - 11-20 car.'
         WHEN LENGTH(TRIM(MAKTX)) <= 30 THEN '04 - 21-30 car.'
         ELSE '05 - > 30 car.'
       END AS tranche_longueur,
       COUNT(*) AS nb
FROM BASE_ARTICLE
GROUP BY 1
ORDER BY 1;

