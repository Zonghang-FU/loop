SELECT CASE
         WHEN nb = 1        THEN '1 article'
         WHEN nb <= 5       THEN '2-5'
         WHEN nb <= 20      THEN '6-20'
         WHEN nb <= 100     THEN '21-100'
         WHEN nb <= 1000    THEN '101-1000'
         ELSE '> 1000'
       END AS taille_gm,
       COUNT(*) AS nb_gm,
       SUM(nb)  AS nb_articles_couverts
FROM (
    SELECT TRIM(MATKL) AS gm, COUNT(*) AS nb
    FROM BASE_ARTICLE
    WHERE MATKL IS NOT NULL AND TRIM(MATKL) <> ''
    GROUP BY TRIM(MATKL)
) t
GROUP BY 1;


