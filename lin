@dataclass
class Config:
    targets: list = field(default_factory=lambda: list(TARGETS))
    folder: str = "EXPORT_LINEAGE"
    filename: str = "Documentation_Lineage.xlsx"
    dialect: str = "tsql"
    # Physical SQL table name -> exact Flow dataset reference, for nontrivial mappings.
    sql_table_map: dict = field(default_factory=dict)
    max_depth: int = 100
    max_nodes: int = 100000


@dataclass(frozen=True, order=True)
class Ref:
    dataset: str
    column: str

    def label(self):
        return f"{self.dataset}.{self.column}"


@dataclass
class Recipe:
    name: str
    kind: str
    inputs: list
    outputs: list
    payload: object = None
    error: str = ""


@dataclass
class Step:
    ref: Ref
    parents: list = field(default_factory=list)
    recipe: str = ""
    kind: str = ""
    change: str = ""
    expression: str = ""
    row_effect: str = ""
    status: str = "Confirmed"
    note: str = ""
    terminal: str = ""  # source, generated, unknown
    candidates: list = field(default_factory=list)


class DataikuSource:
    """Cache live metadata; never execute recipes or write datasets/settings."""
    def __init__(self, client, project):
        self.client, self.project = client, project
        self.key = project.project_key
        self.issues = []

    def normalize(self, name):
        prefix = self.key + "."
        return name[len(prefix):] if name.startswith(prefix) else name

    def dataset(self, name):
        if "." in name:
            key, dataset = name.split(".", 1)
            return self.client.get_project(key).get_dataset(dataset)
        return self.project.get_dataset(name)

    @lru_cache(None)
    def schema(self, name):
        return self.dataset(name).get_schema().get("columns", [])

    @lru_cache(None)
    def table_names(self, name):
        params = self.dataset(name).get_settings().get_raw().get("params", {})
        table = params.get("table", "")
        schema = params.get("schema", "")
        return [x for x in (table, f"{schema}.{table}" if schema and table else "") if x]

    def recipes(self):
        def refs(roles):
            return [self.normalize(i["ref"]) for role in roles.values()
                    for i in role.get("items", []) if i.get("ref")]
        return [Recipe(r["name"], r["type"], refs(r.get("inputs", {})),
                       refs(r.get("outputs", {}))) for r in self.project.list_recipes()]

    @lru_cache(None)
    def payload(self, name, kind):
        settings = self.project.get_recipe(name).get_settings()
        return (settings.get_payload() if kind in Engine.SQL_TYPES
                else settings.get_json_payload())



class Engine:
    SQL_TYPES = {"sql_query", "sql_script", "impala"}

    def __init__(self, source, config=None):
        self.source, self.config = source, config or Config()
        self.producers = {}
        for recipe in source.recipes():
            for output in recipe.outputs:
                self.producers.setdefault(output, []).append(recipe)
        self.steps = {}
        self.issues = []
        self._messages = set()

    def warn(self, subject, message):
        key = (subject, message)
        if key not in self._messages:
            self._messages.add(key)
            print(f"WARNING [{subject}]: {message}", flush=True)

    @lru_cache(None)
    def columns(self, dataset):
        # Keep original casing for display; matching is case-insensitive only if unique.
        return tuple(c["name"] for c in self.source.schema(dataset))

    def column(self, dataset, name):
        cols = self.columns(dataset)
        if name in cols:
            return name
        matches = [c for c in cols if c.casefold() == name.casefold()]
        if len(matches) != 1:
            raise ValueError(f"Missing or ambiguous field : {dataset}.{name}")
        return matches[0]

    def payload(self, recipe):
        if recipe.error:
            raise ValueError(recipe.error)
        return (recipe.payload if recipe.payload is not None
                else self.source.payload(recipe.name, recipe.kind))

    def same_name(self, inputs, name):
        found, errors = [], []
        for ds in inputs:
            try:
                cols = self.columns(ds)
                matches = [c for c in cols if c.casefold() == name.casefold()]
                found.extend(Ref(ds, c) for c in matches)
            except Exception as exc:
                errors.append(f"{ds}: {exc}")
        return found, errors

    def resolve(self, ref):
        if ref in self.steps:
            return self.steps[ref]
        step = Step(ref)
        self.steps[ref] = step
        try:
            self.column(ref.dataset, ref.column)
            producers = self.producers.get(ref.dataset, [])
            if not producers:
                step.change, step.terminal = "Flow source", "source"
                step.note = "Source in the accessible Flow; external origin is outside this analysis."
                return step
            if len(producers) != 1:
                raise ValueError("Multiple recipes produce this dataset")
            recipe = producers[0]
            step.recipe, step.kind = recipe.name, recipe.kind
            if recipe.kind in self.SQL_TYPES:
                if not getattr(self.config, "_sql_enabled", True):
                    raise ValueError("SQL analysis unavailable in this environment. "
                                     "See the dependency diagnostics printed at startup.")
                self.sql(step, recipe)
                if getattr(self.config, "_sql_fallback", False):
                    step.status, step.terminal = "Needs review", "unknown"
                    step.note = "Generic SQL parser used because the configured dialect failed. Verify this step manually."
                    self.warn(ref.label(), step.note)
            elif recipe.kind == "shaker":
                self.prepare(step, recipe)
            elif recipe.kind == "sync" and len(recipe.inputs) == 1:
                step.parents = [Ref(recipe.inputs[0], self.column(recipe.inputs[0], ref.column))]
                step.change = "Copy"
            else:
                step.candidates, errors = self.same_name(recipe.inputs, ref.column)
                raise ValueError(f"Field lineage is not supported for recipe type {recipe.kind}. "
                                 + "; ".join(errors))
        except Exception as exc:
            step.status, step.terminal = "Needs review", "unknown"
            step.note = str(exc)
            step.change = step.change or "Unresolved logic"
            self.warn(ref.label(), str(exc))
        return step

    def sql(self, step, recipe):
        import sqlglot
        from sqlglot import exp
        from sqlglot.lineage import lineage
        dialect = getattr(self.config, "_effective_dialect", self.config.dialect)

        if len(recipe.outputs) != 1:
            raise ValueError("SQL has multiple outputs; query-to-output mapping requires review")
        code = self.payload(recipe)
        if not isinstance(code, str) or not code.strip():
            raise ValueError("Empty SQL")
        # Dataiku dataset placeholders, not arbitrary project-variable substitution.
        code = re.sub(r"\$\{(?:input|output):([^}]+)\}", lambda m: "`" + m[1] + "`", code)
        statements = [s for s in sqlglot.parse(code, read=dialect) if s]
        # Multiple statements may implement intermediate writes or branches. Never pick one silently.
        if len(statements) != 1:
            raise ValueError("Multi-statement SQL script; manual mapping is required")
        query = statements[0]
        if isinstance(query, (exp.Create, exp.Insert)):
            query = query.expression
        query_types = tuple(getattr(exp, name) for name in ("Query", "Select", "Union", "Subquery")
                            if hasattr(exp, name))
        if not isinstance(query, query_types):
            raise ValueError("SQL statement has no supported SELECT query")
        effect_query = query.copy()

        aliases = {}
        for ds in recipe.inputs:
            names = [ds]
            try:
                names += self.source.table_names(ds)
            except Exception as exc:
                self.warn(ds, f"Cannot read physical SQL table settings: {exc}. "
                          "Use the Flow name or configure sql_table_map.")
            for name in names:
                aliases.setdefault(name.casefold(), set()).add(ds)
        for name, ds in self.config.sql_table_map.items():
            if ds not in recipe.inputs:
                continue
            aliases[name.casefold()] = {ds}

        schema = {}
        # Replace physical table names by unambiguous local tokens for schema qualification.
        tokens, mapped = {}, {}
        for table in query.find_all(exp.Table):
            name = ".".join(part for part in (table.catalog, table.db, table.name) if part)
            matches = aliases.get(name.casefold(), set())
            if len(matches) > 1:
                raise ValueError(f"Ambiguous SQL table: {name}. Configure sql_table_map.")
            if not matches:
                continue  # CTE names are resolved by sqlglot, unknown leaves are rejected below.
            ds = next(iter(matches))
            token = tokens.setdefault(ds, f"flow_input_{len(tokens)}")
            mapped[token] = ds
            schema[token] = {c: "UNKNOWN" for c in self.columns(ds)}
            # Preserve explicit alias; implicit table qualifiers need the original short name.
            if not table.args.get("alias"):
                table.set("alias", exp.TableAlias(this=exp.to_identifier(table.name)))
            table.set("this", exp.to_identifier(token))
            table.set("db", None)
            table.set("catalog", None)

        graph = lineage(step.ref.column, query, schema=schema, dialect=dialect,
                        validate_qualify_columns=True)
        root_expr = graph.expression
        step.expression = root_expr.sql(dialect=dialect)
        parents, unresolved = set(), []

        def walk(node):
            if node.downstream:
                for child in node.downstream:
                    walk(child)
            elif isinstance(node.expression, exp.Table):
                ds = mapped.get(node.expression.name)
                name = node.name.rsplit(".", 1)[-1].strip('`"')
                if ds:
                    parents.add(Ref(ds, self.column(ds, name)))
                else:
                    unresolved.append(node.name)
            elif isinstance(node.expression, getattr(exp, "Placeholder", ())):
                unresolved.append(node.name)
            elif list(node.expression.find_all(exp.Column)):
                unresolved.append(node.name)

        walk(graph)
        step.parents = sorted(parents)
        if unresolved:
            raise ValueError("Unresolved SQL origins: " + ", ".join(unresolved))
        expression = root_expr.this if isinstance(root_expr, exp.Alias) else root_expr
        if not parents:
            if any(query.find_all(exp.AggFunc)) or any(query.find_all(exp.Window)):
                raise ValueError("Row calculation without an explicit source field (aggregate/window). "
                                 "Document row dependencies manually.")
            step.change, step.terminal = "SQL creation without a source field", "generated"
        elif isinstance(expression, exp.Column) and len(parents) == 1:
            step.change = ("SQL pass-through" if step.parents[0].column.casefold() == step.ref.column.casefold()
                           else "SQL rename")
            # A CTE may hide calculations even when the outer projection is a plain column.
            internal = [n for n in sql_nodes(graph) if n.downstream and n is not graph]
            if internal:
                step.change = "SQL projection with internal steps"
                step.expression = "\n".join(dict.fromkeys(n.expression.sql() for n in sql_nodes(graph) if n.downstream))
        else:
            step.change = "SQL calculation from multiple fields" if len(parents) > 1 else "SQL calculation"
        # UNION and CTE nodes can hold additional transformations absent from the outer projection.
        expressions = [n.expression.sql(dialect=dialect) for n in sql_nodes(graph)
                       if n is graph or n.downstream]
        step.expression = "\n".join(dict.fromkeys(expressions))
        if isinstance(query, exp.Union):
            step.change = "SQL combination (UNION)"
        effects = []
        for name in ("Join", "Where", "Group", "Having", "Qualify", "Distinct", "Limit"):
            cls = getattr(exp, name, None)
            if cls is not None:
                effects.extend(x.sql(dialect=dialect) for x in effect_query.find_all(cls))
        if isinstance(query, exp.Union):
            effects.insert(0, "UNION: combine input branches")
        step.row_effect = "\n".join(effects)

    def prepare(self, step, recipe):
        """Reverse every operation, then bind the resulting names to the input schema.

        Only explicit supported operations establish lineage. Other processors stay visible
        and stop certification, since their parameters vary across DSS versions.
        """
        if len(recipe.inputs) != 1:
            raise ValueError("Prepare recipes with multiple inputs are not supported")
        payload = self.payload(recipe)
        needed = {step.ref.column}
        changes, effects, unresolved = [], [], []
        for operation in reversed(payload.get("steps", [])):
            if operation.get("disabled") or operation.get("enabled") is False:
                continue
            kind, params = operation.get("type", ""), operation.get("params", {})
            if kind == "ColumnRename":
                renames = params.get("renamings")
                if renames is None and "from" in params and "to" in params:
                    renames = [{"from": params["from"], "to": params["to"]}]
                if not isinstance(renames, list) or any("from" not in r or "to" not in r for r in renames):
                    unresolved.append("Unknown ColumnRename format: " + json.dumps(params, ensure_ascii=False))
                    continue
                mapping = {r["to"]: r["from"] for r in renames}
                for name in sorted(needed & mapping.keys()):
                    changes.append(f"Rename: {mapping[name]} -> {name}")
                needed = {mapping.get(name, name) for name in needed}
            elif kind == "CreateColumnWithGREL":
                target = params.get("column") or params.get("newColumnName")
                if not target:
                    unresolved.append("Missing GREL output field: " + json.dumps(params, ensure_ascii=False))
                elif target in needed:
                    expression = params.get("expression", "")
                    refs, known = grel_refs(expression)
                    changes.append(f"{target} = {expression}")
                    needed.remove(target)
                    needed.update(refs)
                    if not known:
                        unresolved.append("GREL is not fully supported: " + expression)
            elif kind in {"KeepOnlyColumns", "RemoveColumn"}:
                effects.append(kind + " : " + json.dumps(params, ensure_ascii=False))
                # No value transformation for fields retained by the recipe's actual output schema.
            else:
                unresolved.append(kind + " : " + json.dumps(params, ensure_ascii=False))
        step.expression = "\n".join(reversed(changes))
        step.row_effect = "\n".join(reversed(effects))
        step.parents = [Ref(recipe.inputs[0], self.column(recipe.inputs[0], name)) for name in sorted(needed)]
        if unresolved:
            step.candidates, step.parents = step.parents, []
            raise ValueError("Processors requiring review: " + "\n".join(reversed(unresolved)))
        step.change = "Prepare transformation" if changes else "Prepare pass-through"
        if not needed:
            step.change, step.terminal = "Prepare creation without a source field", "generated"

    def collect(self):
        targets = []
        for ds in self.config.targets:
            print(f"Reading target schema: {ds}", flush=True)
            try:
                targets.extend(Ref(ds, c) for c in self.columns(ds))
            except Exception as exc:
                self.issues.append({"dataset": ds, "message": str(exc)})
                self.warn(ds, str(exc))
        def visit(ref, active, depth):
            if depth > self.config.max_depth:
                raise ValueError(f"Maximum depth exceeded: {ref.label()}")
            if ref in active:
                self.warn(ref.label(), "Cycle detected; absolute levels will be blank.")
                return
            if ref in expanded:
                return
            if len(self.steps) >= self.config.max_nodes:
                raise ValueError("Node limit exceeded; increase max_nodes")
            step = self.resolve(ref)
            for parent in step.parents:
                visit(parent, active | {ref}, depth + 1)
            expanded.add(ref)
        expanded = set()
        for ref in targets:
            visit(ref, set(), 0)
        return Report(self, targets)


def sql_nodes(root):
    """Walk the stable downstream links without requiring Node.walk()."""
    pending, seen = [root], set()
    while pending:
        node = pending.pop()
        if id(node) in seen:
            continue
        seen.add(id(node))
        yield node
        pending.extend(reversed(node.downstream))


def grel_refs(expression):
    """A deliberately conservative GREL subset. Never identify fields by substring."""
    refs = set()
    patterns = [r'\bval\(\s*["\']([^"\']+)["\']\s*\)',
                r'\bcells\[\s*["\']([^"\']+)["\']\s*\]\.value',
                r'\bcells\.([A-Za-z_]\w*)\.value']
    residual = expression
    for pattern in patterns:
        refs.update(re.findall(pattern, residual))
        residual = re.sub(pattern, " 0 ", residual)
    residual = re.sub(r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'', '""', residual)
    # Bare identifiers (including an unparsed function call) need a version-specific parser.
    names = set(re.findall(r"[A-Za-z_]\w*", residual))
    allowed = {"if", "isNull", "isBlank", "concat", "toString", "toNumber", "trim",
               "uppercase", "lowercase", "round", "abs", "true", "false", "null"}
    return refs, names <= allowed and bool(expression.strip())


class Report:
    def __init__(self, engine, targets):
        self.engine, self.targets = engine, targets

    @lru_cache(None)
    def facts(self, ref, active=frozenset()):
        # Branch-local cycle detection: convergent DAGs are not cycles.
        if ref in active:
            return None, None, frozenset(), False, frozenset({"Cycle"})
        step = self.engine.steps[ref]
        if step.terminal == "source":
            return 0, 0, frozenset({ref}), True, frozenset()
        if step.terminal == "generated":
            return 0, 0, frozenset({ref}), True, frozenset()
        if not step.parents:
            return None, None, frozenset(), False, frozenset({step.note or "Unknown origin"})
        upstream = [self.facts(p, active | {ref}) for p in step.parents]
        complete = step.status == "Confirmed" and all(f[3] for f in upstream)
        origins = frozenset().union(*(f[2] for f in upstream))
        notes = frozenset().union(*(f[4] for f in upstream))
        if step.status != "Confirmed":
            notes |= {step.note}
        # Unknown branches never receive a fabricated absolute level.
        lo = min(f[0] for f in upstream) + 1 if complete else None
        hi = max(f[1] for f in upstream) + 1 if complete else None
        return lo, hi, origins, complete, notes

    def reachable(self, target):
        seen, pending = set(), [target]
        while pending:
            ref = pending.pop()
            if ref in seen:
                continue
            seen.add(ref)
            pending.extend(self.engine.steps[ref].parents)
        return seen

    def rows(self):
        for target in self.targets:
            nodes = sorted(self.reachable(target), key=lambda ref: (
                self.facts(ref)[1] if self.facts(ref)[1] is not None else 10**9, ref))
            for ref in nodes:
                step = self.engine.steps[ref]
                low, high, roots, complete, notes = self.facts(ref)
                level = low if low == high else f"{low}-{high}"
                if not complete:
                    level = None
                yield [target.dataset, target.column, level, ref.dataset, ref.column,
                       "\n".join(parent.label() for parent in step.parents),
                       step.change if step.status == "Confirmed" else "Unresolved (see notebook output)",
                       step.expression, step.recipe, step.row_effect]


HEADERS = ["Target dataset", "Target field", "Level", "Dataset at this step",
           "Field at this step", "Direct parents (dataset.field)", "Change at this step",
           "Expression", "Recipe", "Effects on rows"]


def export_excel(report):
    """Write one plain sheet with filters and a frozen header. No extra files."""
    import xlsxwriter
    output = BytesIO()
    workbook = xlsxwriter.Workbook(output, {"in_memory": True, "strings_to_formulas": False,
                                          "strings_to_urls": False})
    sheet = workbook.add_worksheet("Lineage")
    body = workbook.add_format({"text_wrap": True, "valign": "top"})
    header = workbook.add_format({"bold": True, "text_wrap": True, "valign": "top"})
    widths = [32, 25, 10, 32, 25, 46, 34, 65, 30, 65]
    for col, width in enumerate(widths):
        sheet.set_column(col, col, width, body)
    sheet.write_row(0, 0, HEADERS, header)
    sheet.set_row(0, 30)
    count = 0
    for count, row in enumerate(report.rows(), 1):
        if count >= 1048576:
            raise ValueError("Excel row limit exceeded. Reduce USER_CONFIG.targets.")
        for col, value in enumerate(row):
            if isinstance(value, str) and len(value) > 32767:
                raise ValueError(f"Excel cell limit exceeded for {row[0]}.{row[1]}, "
                                 f"step {row[3]}.{row[4]}, column {HEADERS[col]}. "
                                 "No report has been uploaded.")
        sheet.write_row(count, 0, row)
        lines = max((sum(max(1, len(line) // max(1, widths[col] - 2) + 1)
                         for line in str(value).splitlines())
                     for col, value in enumerate(row) if value is not None), default=1)
        sheet.set_row(count, min(409, max(30, lines * 15)))
    sheet.freeze_panes(1, 2)
    sheet.autofilter(0, 0, count, len(HEADERS) - 1)
    workbook.close()
    return output.getvalue()


def check_dependencies(config):
    """Probe installed capabilities without installing or pinning packages."""
    config._sql_enabled = False
    config._sql_fallback = False
    config._effective_dialect = config.dialect
    try:
        version = metadata.version("sqlglot")
    except metadata.PackageNotFoundError:
        version = "unknown / not installed"
    print(f"Python: {sys.executable}", flush=True)
    print(f"Installed SQLGlot version: {version}", flush=True)
    try:
        import xlsxwriter
    except Exception as exc:
        print(f"ERROR: Excel writer unavailable: {type(exc).__name__}: {exc}", flush=True)
        raise RuntimeError("Excel export needs an available company-approved XlsxWriter package.") from None
    print(f"XlsxWriter version: {getattr(xlsxwriter, '__version__', 'unknown')}", flush=True)
    try:
        import sqlglot
        from sqlglot.lineage import lineage
    except Exception as exc:
        print(f"WARNING: SQL analysis disabled: {type(exc).__name__}: {exc}", flush=True)
        print("The installed SQLGlot core or lineage API cannot be imported. "
              "Prepare and sync analysis will continue; SQL steps will remain unresolved. "
              "Share this version and error with the environment administrator. "
              "If packages were recently changed, restart the kernel before retrying.", flush=True)
        return
    print(f"SQLGlot module: {getattr(sqlglot, '__file__', 'unknown')}", flush=True)

    def probe(dialect):
        # These calls exercise the same schema, parser and optimizer API as the engine.
        sqlglot.parse("SELECT x FROM dependency_check", read=dialect)
        lineage("x", "SELECT x FROM dependency_check", schema={"dependency_check": {"x": "INT"}},
                dialect=dialect, validate_qualify_columns=True)

    try:
        probe(config.dialect)
        config._sql_enabled = True
        print(f"SQL parser ready for dialect {config.dialect or 'generic'}.", flush=True)
        return
    except Exception as exc:
        print(f"WARNING: Configured SQL parser failed ({config.dialect or 'generic'}): "
              f"{type(exc).__name__}: {exc}", flush=True)
    if config.dialect:
        try:
            probe(None)
            config._effective_dialect = None
            config._sql_enabled = True
            config._sql_fallback = True
            print("WARNING: Using the installed generic SQL parser. This does not establish "
                  "support for the original SQL dialect. Every SQL step will be marked unresolved "
                  "with blank absolute levels until manually verified. No package changes were made.", flush=True)
            return
        except Exception as exc:
            print(f"WARNING: Generic SQL parser also failed: {type(exc).__name__}: {exc}", flush=True)
    print("WARNING: SQL analysis is unavailable in this environment. Other recipes will still "
          "be analyzed. SQL steps will be unresolved. Share the printed package version and "
          "error with the environment administrator; no specific replacement version is required.", flush=True)


def run_dataiku(config=None):
    config = config or Config()
    print(f"Dataiku Lineage {SCRIPT_VERSION} | SQL dialect: {config.dialect or 'generic'}", flush=True)
    check_dependencies(config)
    import dataiku
    client = dataiku.api_client()
    source = DataikuSource(client, client.get_default_project())
    engine = Engine(source, config)
    print("Reading Flow metadata and tracing upstream fields...", flush=True)
    report = engine.collect()
    if not report.targets:
        raise RuntimeError("No target fields are accessible. No report was exported.")
    incomplete = sum(not report.facts(target)[3] for target in report.targets)
    print(f"Analysis finished: {len(report.targets)} target fields, {incomplete} incomplete paths, "
          f"{len(engine._messages)} warnings.", flush=True)
    if incomplete or engine.issues:
        print("WARNING: This export is partial. Unresolved steps are labeled in the sheet; "
              "their absolute levels are blank. See the warnings above.", flush=True)
    content = export_excel(report)
    folder = dataiku.Folder(config.folder)
    folder.upload_stream(config.filename, content)
    print(f"Exported one Excel file: {config.filename} in managed folder {config.folder}.", flush=True)
    return report


