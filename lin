# --- 5. MISE EN TABLE DU LINEAGE, UNE LIGNE PAR ÉTAPE ---
from io import BytesIO
from openpyxl.styles import Alignment, Font, PatternFill

# Même sélection de recette que dans le moteur : première recette trouvée.
recette_par_dataset = {}
for recipe in recipes:
    for role in recipe.get('outputs', {}).values():
        for item in role.get('items', []):
            if item.get('ref'):
                recette_par_dataset.setdefault(item['ref'], recipe)

# Réutilisation du moteur existant, sans modifier son résultat ni sa logique.
cache_lineage_export = {}


def lineage_pour_export(dataset_name, col_name):
    cle = (dataset_name, col_name)
    if cle not in cache_lineage_export:
        cache_lineage_export[cle] = trouver_lineage_detaille(dataset_name, col_name)
    return cache_lineage_export[cle]


def lignes_pour_export(table_name, nom_champ, traduction):
    resultat = lineage_pour_export(table_name, nom_champ)
    chemin = resultat.get('chemin', [])
    boucle = any(ds.endswith(' (Boucle)') for ds in chemin)
    lignes = []

    for niveau, dataset_etape in enumerate(chemin):
        precedent = chemin[niveau - 1] if niveau else ''
        recipe = recette_par_dataset.get(dataset_etape, {})
        recette_etape = recipe.get('name') or ''

        if dataset_etape.endswith(' (Boucle)'):
            changement = 'Boucle détectée : origine et niveaux indéterminés'
        else:
            detail = lineage_pour_export(dataset_etape, nom_champ)
            regle = detail.get('regle', '')
            inputs = dataset_to_inputs.get(dataset_etape, [])

            if not inputs:
                changement = 'Source primaire : donnée brute'
                recette_etape = ''
            elif recette_etape and detail.get('recette') == recette_etape:
                # La règle appartient à la recette de CETTE étape.
                # Une règle héritée d'une recette amont n'est pas répétée ici.
                changement = regle or 'Aucune transformation détectée à cette étape'
            elif (detail.get('recette') == 'Logique masquée'
                  and detail.get('chemin') == [dataset_etape]):
                changement = regle
            else:
                changement = 'Aucune transformation détectée à cette étape'

            if niveau == 0 and inputs:
                changement = (
                    'Début de trace : champ non retrouvé sous ce nom dans les inputs. '
                    + changement
                )

        lignes.append({
            'Table cible': table_name,
            'Champ': nom_champ,
            'Traduction': traduction,
            # Une boucle ne permet pas de compter depuis une origine connue.
            'Niveau (source = 0)': None if boucle else niveau,
            'Dataset de cette étape': dataset_etape,
            'Dataset précédent': precedent,
            'Champ précédent': nom_champ if precedent else '',
            'Recette de cette étape': recette_etape,
            'Changements à cette étape': changement,
        })
    return lignes


colonnes_export = [
    'Table cible', 'Champ', 'Traduction', 'Niveau (source = 0)',
    'Dataset de cette étape', 'Dataset précédent', 'Champ précédent',
    'Recette de cette étape', 'Changements à cette étape',
]
donnees_lineage = []
nombre_champs = 0
print('⏳ Construction du tableau de lineage par étapes...')

for table_name in tables_a_documenter:
    try:
        dataset = project.get_dataset(table_name)
        schema = dataset.get_schema()

        for col in schema.get('columns', []):
            nom_champ = col.get('name', '')
            traduction = dict_traductions.get(nom_champ, '')
            donnees_lineage.extend(
                lignes_pour_export(table_name, nom_champ, traduction)
            )
            nombre_champs += 1
    except Exception as e:
        print(f"⚠️ Erreur lors de l'analyse de la table {table_name}: {e}")

# L'ordre des tables et des champs est conservé ; chaque chemin va de 0 à N.
df_lineage = pd.DataFrame(donnees_lineage, columns=colonnes_export)
df_lineage['Niveau (source = 0)'] = pd.array(
    df_lineage['Niveau (source = 0)'], dtype='Int64'
)
print(f'✅ {nombre_champs} champs analysés ; {len(df_lineage)} étapes à exporter.')

# --- 6. EXPORT EXCEL : UN SEUL ONGLET, UN TABLEAU SIMPLE ---
nom_du_dossier = 'EXPORT_LINEAGE'
nom_du_fichier = 'Documentation_Lineage.xlsx'

try:
    if len(df_lineage) > 1_048_575:
        raise ValueError('Le nombre de lignes dépasse la capacité d’un onglet Excel.')

    buffer_excel = BytesIO()
    with pd.ExcelWriter(buffer_excel, engine='openpyxl') as writer:
        df_lineage.to_excel(writer, sheet_name='Lineage', index=False)
        feuille = writer.sheets['Lineage']

        # Garder les identifiants de champ et les en-têtes visibles.
        feuille.freeze_panes = 'D2'
        feuille.auto_filter.ref = feuille.dimensions
        feuille.row_dimensions[1].height = 32

        largeurs = {
            'A': 34, 'B': 26, 'C': 32, 'D': 20, 'E': 38,
            'F': 38, 'G': 26, 'H': 38, 'I': 85,
        }
        for lettre, largeur in largeurs.items():
            feuille.column_dimensions[lettre].width = largeur

        for cellule in feuille[1]:
            cellule.font = Font(bold=True)
            cellule.fill = PatternFill('solid', fgColor='EEEEEE')
            cellule.alignment = Alignment(vertical='center', wrap_text=True)

        for ligne in feuille.iter_rows(min_row=2):
            hauteur = 1
            for cellule in ligne:
                cellule.alignment = Alignment(vertical='top', wrap_text=True)
                if isinstance(cellule.value, str):
                    # SQL/GREL et noms de champs restent du texte, même avec '='.
                    cellule.data_type = 's'
                    largeur = max(1, int(largeurs[cellule.column_letter]) - 3)
                    hauteur = max(hauteur, sum(
                        max(1, (len(partie) + largeur - 1) // largeur)
                        for partie in cellule.value.split('\n')
                    ))
            feuille.row_dimensions[ligne[0].row].height = min(409, 16 * hauteur + 6)

    buffer_excel.seek(0)
    dossier = dataiku.Folder(nom_du_dossier)
    dossier.upload_stream(nom_du_fichier, buffer_excel.getvalue())
    print(f'🚀 SUCCÈS : {nom_du_fichier} généré dans {nom_du_dossier}.')
except Exception as e:
    print(f"❌ ERREUR d'écriture : {e}")
    raise
