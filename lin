import dataiku
import pandas as pd
import re
import sqlglot
from sqlglot.expressions import Alias, Column
 
# --- 1. CONNEXION ET CONFIGURATION ---
client = dataiku.api_client()
project = client.get_default_project()
 
tables_a_documenter = [
    "SUPPLIER_SCOPE_FAM",
    "ZMMENGAGT_kpi_engagement_5years",
    "NATCO_BACKLOG_5YEARS",
    "EKPO_purchasing_document_item_5years",
    "EKKO_purchasing_document_header",
    "VIEW_SUPPLIER",
    "NC",
    "EBAN_SUP_ID"
]
 
# --- 2. CHARGEMENT DES TRADUCTIONS ---
print("⏳ Chargement du dictionnaire de traductions...")
dict_traductions = {}
try:
    ds_trad = dataiku.Dataset("Field_Translation_stacked")
    df_trad = ds_trad.get_dataframe(columns=['Column_name', 'English'])
    for index, row in df_trad.iterrows():
        col_name = row['Column_name']
        english_translation = row['English']
        if pd.notna(col_name) and pd.notna(english_translation) and str(col_name).strip() != "":
            dict_traductions[str(col_name)] = str(english_translation)
    print(f"✅ {len(dict_traductions)} traductions chargées.")
except Exception as e:
    print(f"⚠️ Impossible de charger la table des traductions : {e}")
 
# --- 3. CARTOGRAPHIE DU FLOW & SYSTÈME DE CACHE ---
print("⏳ Analyse du Flow pour mapper les dépendances...")
recipes = project.list_recipes()
dataset_to_inputs = {}
 
for recipe in recipes:
    inputs = [item.get('ref', '') for role in recipe.get('inputs', {}).values() for item in role.get('items', [])]
    for role, role_data in recipe.get('outputs', {}).items():
        for item in role_data.get('items', []):
            out_ref = item.get('ref', '')
            if out_ref:
                dataset_to_inputs[out_ref] = inputs
 
schema_cache = {}
def get_columns_from_source(dataset_name):
    if dataset_name not in schema_cache:
        try:
            schema = project.get_dataset(dataset_name).get_schema()
            schema_cache[dataset_name] = [c['name'].lower() for c in schema.get('columns', [])]
        except Exception:
            schema_cache[dataset_name] = []
    return schema_cache[dataset_name]
 
# --- 4. LE MOTEUR RÉCURSIF (GÉNÉRATION DES ÉTAPES VISUELLES) ---
def trouver_lineage_detaille(dataset_name, col_name, visited=None):
    if visited is None:
        visited = set()
    if dataset_name in visited:
        return {"chemin": [f"{dataset_name} (Boucle)"], "recette": "Erreur", "regle": "Boucle détectée"}
    visited.add(dataset_name)
 
    inputs = dataset_to_inputs.get(dataset_name, [])
   
    # Condition d'arrêt : on est sur une table brute sans parent
    if not inputs:
        return {"chemin": [dataset_name], "recette": "Source Primaire", "regle": "Donnée brute"}
 
    recipe_name = "N/A"
    recipe_type = "N/A"
    for recipe in recipes:
        outputs = [item.get('ref') for role in recipe.get('outputs', {}).values() for item in role.get('items', [])]
        if dataset_name in outputs:
            recipe_name = recipe.get('name')
            recipe_type = recipe.get('type')
            break
 
    col_lower = col_name.lower()
    transformation_trouvee = []
 
    try:
        full_recipe = project.get_recipe(recipe_name)
        recipe_settings = full_recipe.get_settings()
 
        # 4A. Shaker
        if recipe_type == "shaker":
            payload = recipe_settings.get_json_payload()
            for step in payload.get('steps', []):
                step_str = str(step).lower()
                if col_lower in step_str:
                    type_action = step.get('type', '')
                    if type_action not in ['KeepOnlyColumns', 'RemoveColumn']:
                        if type_action == 'CreateColumnWithGREL':
                            expr = step.get('params', {}).get('expression', '')
                            transformation_trouvee.append(f"Formule: {expr}")
                        elif type_action == 'ColumnRename':
                            transformation_trouvee.append("Renommage")
                        else:
                            transformation_trouvee.append(f"Action: {type_action}")
 
        # 4B. SQL (Hybride)
        elif recipe_type in ["sql_query", "sql_script", "impala"]:
            code_sql_brut = recipe_settings.get_payload()
            if code_sql_brut:
                sql_parse_reussi = False
               
                try:
                    parsed_statements = sqlglot.parse(code_sql_brut, read='hive')
                    for stmt in parsed_statements:
                        if not stmt: continue
                        for select_expression in stmt.find_all(sqlglot.expressions.Select):
                            for projection in select_expression.expressions:
                                if isinstance(projection, Alias):
                                    if projection.alias.lower() == col_lower:
                                        expr_gauche = projection.this.sql().lower()
                                        expr_gauche_clean = expr_gauche.replace('"', '').replace('`', '').replace("'", "")
                                        # Si c'est un vrai calcul
                                        if expr_gauche_clean != col_lower and not expr_gauche_clean.endswith(f".{col_lower}"):
                                            transformation_trouvee.append(f"SQL: {projection.this.sql()}")
                                        sql_parse_reussi = True
                                        break
                                elif isinstance(projection, Column):
                                    if projection.name.lower() == col_lower:
                                        sql_parse_reussi = True
                                        break
                except Exception:
                    pass
                
                if not sql_parse_reussi:
                    for ligne in code_sql_brut.split('\n'):
                        ligne_lower = ligne.lower()
                        match = re.search(r'([^,]+?)\s+as\s+"?' + re.escape(col_lower) + r'"?\b', ligne_lower)
                        if match:
                            gauche = match.group(1).strip()
                            gauche_clean = gauche.replace('"', '').replace('`', '').replace("'", "")
                            if gauche_clean != col_lower and not gauche_clean.endswith(f".{col_lower}"):
                                extrait = " ".join(ligne.strip().split())
                                transformation_trouvee.append(f"SQL (Regex): {extrait[:150]}")
                            break
 
    except Exception as api_err:
        transformation_trouvee.append(f"Erreur API: {str(api_err)}")
 
    # 4C. Remontée du courant pour construire le chemin
    exists_in_inputs = [ds for ds in inputs if col_lower in get_columns_from_source(ds)]
 
    chemin_complet = [dataset_name]
 
    if exists_in_inputs:
        # On suit la branche où la colonne existe
        resultat_amont = trouver_lineage_detaille(exists_in_inputs[0], col_name, visited.copy())
       
        # On ajoute la table actuelle à la fin du chemin
        chemin_complet = resultat_amont["chemin"] + [dataset_name]
       
        # Si une transformation a lieu ICI, on écrase la règle amont, mais on garde le chemin complet
        if transformation_trouvee:
            return {
                "chemin": chemin_complet,
                "recette": recipe_name,
                "regle": " | ".join(transformation_trouvee)
            }
        else:
            return {
                "chemin": chemin_complet,
                "recette": resultat_amont["recette"],
                "regle": resultat_amont["regle"]
            }
    else:
        # La colonne n'existe plus en amont, la trace s'arrête
        return {
            "chemin": chemin_complet,
            "recette": recipe_name if transformation_trouvee else "Logique masquée",
            "regle": " | ".join(transformation_trouvee) if transformation_trouvee else f"Champ généré ici (Type: {recipe_type})"
        }
 
